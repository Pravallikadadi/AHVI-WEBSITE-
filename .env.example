# ==============================================================================
# AHVI Production Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), add these variables in your Project Settings.

# ------------------------------------------------------------------------------
# Appwrite Backend Configuration
# ------------------------------------------------------------------------------
# Your Appwrite API endpoint (default for Appwrite Cloud is https://cloud.appwrite.io/v1)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite Project ID (Found in Appwrite Console > Project Settings)
APPWRITE_PROJECT_ID=your_appwrite_project_id

# Server API Key with scopes: databases.*, collections.*, documents.*, files.*, users.*
# Created in Appwrite Console > Project Settings > View API Keys > Create API Key
# NEVER expose this key to frontend code or commit to source control.
APPWRITE_API_KEY=your_appwrite_server_api_key

# Database ID (Created automatically by setup script or in Appwrite Console)
APPWRITE_DATABASE_ID=ahvi_db

# Storage Bucket for blog cover images & media assets
APPWRITE_STORAGE_BUCKET_ID=ahvi_media

# Collection IDs (defaults match the setup script)
APPWRITE_COLLECTION_CONTACTS=contacts
APPWRITE_COLLECTION_WAITLIST=waitlist
APPWRITE_COLLECTION_SURVEYS=surveys
APPWRITE_COLLECTION_SUBSCRIBERS=subscribers
APPWRITE_COLLECTION_ANALYTICS=analytics
APPWRITE_COLLECTION_BLOGS=blogs

# ------------------------------------------------------------------------------
# Admin Authentication & Security
# ------------------------------------------------------------------------------
# Admin email for Appwrite login session
ADMIN_EMAIL=admin@ahvi.com

# Admin password
ADMIN_PASSWORD=change-me-to-a-strong-password

# Random 32+ character string used to cryptographically sign session tokens
ADMIN_SESSION_SECRET=change-this-to-a-secure-random-32-char-string

# ------------------------------------------------------------------------------
# Public Site Configuration
# ------------------------------------------------------------------------------
# Public URL of the deployment (e.g. https://ahvi-website.vercel.app or custom domain)
NEXT_PUBLIC_APP_URL=https://ahvi-website.vercel.app
